# Example only. No production data or credentials in Git.
# PostgreSQL URI must use postgresql+psycopg:// and point to an isolated database.
TASK_AYUZA_DATABASE_URL=postgresql+psycopg://task_ayuza_runtime:REPLACE_ME@127.0.0.1:5432/task_ayuza_test

# Exact HTTPS origin without a trailing slash. Configure for the intended host.
TASK_AYUZA_ORIGIN=https://task-ayuza.example.invalid
# Set a stable cryptographically random 32-byte (64 hex characters) key out-of-band.
# Keep across workers/restarts. Do not commit a real value or rotate to reset limits.
TASK_AYUZA_OUTBOX_INTERVAL=30
# Comma-separated exact addresses/networks of the TLS reverse proxy in front of the app.
# Only from these peers is X-Forwarded-For honoured (right to left). Empty: no proxy,
# the TCP peer is the client. Never list a client network. Run uvicorn with --no-proxy-headers.
TASK_AYUZA_TRUSTED_PROXIES=
TASK_AYUZA_AUTH_HMAC_KEY=
# Simultaneous Argon2id operations per worker process (1-64, default 4). Each takes 64 MiB:
# peak hashing memory = workers x this x 64 MiB. Over the limit a login waits up to 1 s,
# then gets 503 without a limiter charge.
TASK_AYUZA_ARGON2_MAX_CONCURRENT=4
